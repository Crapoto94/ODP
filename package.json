{
  "name": "odp",
  "version": "0.3.5",
  "private": true,
  "scripts": {
    "dev": "SET NODE_OPTIONS=--openssl-legacy-provider && next dev -H 0.0.0.0",
    "dev:https": "SET NODE_OPTIONS=--openssl-legacy-provider && next dev --experimental-https -H 0.0.0.0",
    "build": "next build",
    "start": "SET NODE_OPTIONS=--openssl-legacy-provider && next start",
    "lint": "eslint",
    "prisma:generate:pg": "npx prisma generate --schema=prisma/schema-postgres.prisma",
    "prisma:pull:pg": "npx prisma db pull --schema=prisma/schema-postgres.prisma"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node-forge": "^1.3.14",
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "date-fns": "^4.1.0",
    "docx": "^9.6.1",
    "jose": "^6.2.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "next": "16.1.7",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.6.205",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.0",
    "smb2": "^0.2.11",
    "tesseract.js": "^5.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "jsdom": "^29.0.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
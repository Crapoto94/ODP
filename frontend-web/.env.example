# URL de l'API VibeODP (réseau interne, joignable depuis la DMZ)
BACK_URL=http://vibeodp.ivry.local:3000
# Si BACK_URL est en https avec un certificat interne / auto-signé : ajouter le certificat de l'AC (NODE_EXTRA_CA_CERTS) ou, à défaut :
# BACK_TLS_INSECURE=true
# Clé générée dans VibeODP : Paramètres > Gestion des tournages > Accès du site public
TOURNAGE_API_KEY=
# Origines autorisées à intégrer le formulaire en iframe (séparées par un espace)
FRAME_ANCESTORS=https://www.ivry94.fr

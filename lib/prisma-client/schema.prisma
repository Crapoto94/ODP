generator client {
  provider      = "prisma-client-js"
  output        = "../lib/prisma-client"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tiers {
  id                Int                @id @default(autoincrement())
  nom               String
  siret             String?            @unique
  email             String?
  adresse           String?
  latitude          Float?
  longitude         Float?
  code_sedit        String?            @unique
  statut            String             @default("PROVISOIRE")
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt
  natureJuridique   String?
  etatAdministratif String?
  observations      String?
  photo             String?
  contacts          Contact[]
  occupations       Occupation[]
  notes             Note[]
  favoritedBy       FavoriteCommerce[]

  @@index([nom])
  @@index([code_sedit])
}

model Occupation {
  id                     Int                @id @default(autoincrement())
  nom                    String?
  tiersId                Int
  type                   String
  statut                 String
  dateDebut              DateTime?
  dateFin                DateTime?
  anneeTaxation          Int?
  adresse                String
  latitude               Float?
  longitude              Float?
  description            String?
  observations           String?
  photos                 String?
  montantCalcule         Float              @default(0)
  facturePath            String?
  created_at             DateTime           @default(now())
  updated_at             DateTime           @updatedAt
  numeroFacture          String?
  dossierParentId        Int?
  isCourtMetrage         Boolean            @default(false)
  agissantPour           String?
  isAgissantPourBillable Boolean            @default(false)
  aotGabaritId           Int?
  aotFinalPath           String?
  aotSigned              Boolean            @default(false)
  datePaiement           DateTime?
  dateINIT               DateTime?
  dateINST               DateTime?
  datePREP               DateTime?
  dateEN_COURS           DateTime?
  dateVALIDE             DateTime?
  dateFACTURE            DateTime?
  dateTITRE              DateTime?
  dateCLOS               DateTime?
  dateAlerte             DateTime?
  isArchived             Boolean            @default(false)
  contacts               Contact[]
  dispositifs            Dispositif[]
  lignes                 LigneOccupation[]
  notes                  Note[]
  signatureRequests      SignatureRequest[]
  tiers                  Tiers              @relation(fields: [tiersId], references: [id])

  @@index([tiersId])
  @@index([statut])
  @@index([anneeTaxation])
  @@index([type])
  @@index([isArchived])
}

model Contact {
  id           Int         @id @default(autoincrement())
  nom          String?
  prenom       String?
  email        String?
  telephone    String?
  titre        String?
  role         String      @default("CONTACT_DIRECT")
  occupationId Int?
  tiersId      Int?
  commerceId   Int?
  pjPath       String?
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt
  entreprise   String?
  tiers        Tiers?      @relation(fields: [tiersId], references: [id], onDelete: Cascade)
  occupation   Occupation? @relation(fields: [occupationId], references: [id], onDelete: Cascade)

  @@index([tiersId])
  @@index([occupationId])
}

model Note {
  id           Int         @id @default(autoincrement())
  occupationId Int?
  tiersId      Int?
  content      String
  author       String?
  pjPath       String?
  pjName       String?
  pjThumb      String?
  isEmail      Boolean     @default(false)
  externalId   String?
  fromEmail    String?
  toEmail      String?
  origin       String?     @default("desktop")
  created_at   DateTime    @default(now())
  occupation   Occupation? @relation(fields: [occupationId], references: [id], onDelete: Cascade)
  tiers        Tiers?      @relation(fields: [tiersId], references: [id], onDelete: Cascade)

  @@index([occupationId])
  @@index([tiersId])
}

model O365Message {
  id          String   @id
  subject     String?
  fromName    String?
  fromEmail   String?
  bodyPreview String?
  receivedAt  DateTime
  processed   Boolean  @default(false)
  created_at  DateTime @default(now())
}

model Categorie {
  id       Int         @id @default(autoincrement())
  nom      String
  couleur  String?
  niveau   Int
  parentId Int?
  articles Article[]
  parent   Categorie?  @relation("SubCategories", fields: [parentId], references: [id])
  subs     Categorie[] @relation("SubCategories")
}

model ModeTaxation {
  id       Int       @id @default(autoincrement())
  nom      String    @unique
  articles Article[]
}

model Article {
  id             Int               @id @default(autoincrement())
  numero         String?
  designation    String
  categorieId    Int?
  modeTaxationId Int?
  annee          Int
  montant        Float             @default(0)
  notes          String?
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt
  chapitre       String?           @default("")
  codeInterne    String?           @default("")
  fonction       String?           @default("")
  gestionnaire   String?           @default("")
  nature         String?           @default("")
  sens           String?           @default("")
  structure      String?           @default("")
  typeMouvement  String?           @default("")
  modeTaxation   ModeTaxation?     @relation(fields: [modeTaxationId], references: [id])
  categorie      Categorie?        @relation(fields: [categorieId], references: [id])
  lignes         LigneOccupation[]

  @@index([annee])
  @@index([numero])
}

model User {
  id                Int                @id @default(autoincrement())
  nom               String
  prenom            String
  email             String             @unique
  login             String             @unique
  password          String
  role              String
  isAd              Boolean            @default(false)
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt
  logs              MobileLog[]
  favoriteCommerces FavoriteCommerce[]

  @@index([login])
}

model FavoriteCommerce {
  id         Int      @id @default(autoincrement())
  userId     Int
  tiersId    Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tiers      Tiers    @relation(fields: [tiersId], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  @@unique([userId, tiersId])
}

model MobileLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  action     String?
  userAgent  String?
  deviceInfo String?
  ip         String?
  created_at DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ContextualMessage {
  id       Int     @id @default(autoincrement())
  cle      String  @unique
  label    String?
  sujet    String?
  valeur   String
  disabled Boolean @default(false)
}

model LigneOccupation {
  id                 Int        @id @default(autoincrement())
  occupationId       Int
  articleId          Int
  quantite1          Float      @default(0)
  quantite2          Float      @default(0)
  dateDebut          DateTime?
  dateFin            DateTime?
  dateDebutConstatee DateTime?
  dateFinConstatee   DateTime?
  montant            Float      @default(0)
  created_at         DateTime   @default(now())
  updated_at         DateTime   @updatedAt
  deletedAt          DateTime?
  photos             String?
  note               String?
  article            Article    @relation(fields: [articleId], references: [id])
  occupation         Occupation @relation(fields: [occupationId], references: [id], onDelete: Cascade)

  @@index([occupationId])
  @@index([articleId])
}

model Dispositif {
  id           Int        @id @default(autoincrement())
  nom          String
  statut       String     @default("EN_ATTENTE")
  occupationId Int
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt
  occupation   Occupation @relation(fields: [occupationId], references: [id], onDelete: Cascade)

  @@index([occupationId])
}

model Gabarit {
  id          Int      @id @default(autoincrement())
  nom         String
  type        String   @default("PDF") // PDF or DOCX
  contenu     String? // For PDF: JSON layout, for DOCX: null
  fichierPath String? // For DOCX: path to .docx file
  isDefault   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model TlpeConfig {
  annee            Int     @id @default(autoincrement())
  exoneration      Float   @default(12)
  deliberationPath String?
  tarifsPath       String?
}

model TypeDossierConfig {
  id                  Int      @id @default(autoincrement())
  type                String   @unique
  filienObjet         String?  @default("")
  filienChapitre      String?  @default("")
  filienNature        String?  @default("")
  filienFonction      String?  @default("")
  filienCodeInterne   String?  @default("")
  filienTypeMouvement String?  @default("")
  filienSens          String?  @default("")
  filienStructure     String?  @default("")
  filienGestionnaire  String?  @default("")
  filienPreBordereau  String?  @default("")
  invoiceTemplateId   String?
  updated_at          DateTime @updatedAt
}

model BacklogItem {
  id          Int              @id @default(autoincrement())
  title       String
  description String?
  type        String           @default("FEATURE")
  priority    String           @default("MEDIUM")
  status      String           @default("OPEN")
  versionId   Int?
  requestedBy String?
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt
  comments    BacklogComment[]
  version     VersionRelease?  @relation(fields: [versionId], references: [id])

  @@index([status])
  @@index([versionId])
}

model BacklogComment {
  id            Int         @id @default(autoincrement())
  backlogItemId Int
  content       String
  author        String?
  created_at    DateTime    @default(now())
  backlogItem   BacklogItem @relation(fields: [backlogItemId], references: [id], onDelete: Cascade)

  @@index([backlogItemId])
}

model VersionRelease {
  id            Int           @id @default(autoincrement())
  versionNumber String        @unique
  notes         String?
  releasedAt    DateTime      @default(now())
  created_at    DateTime      @default(now())
  backlogItems  BacklogItem[]
}

model ContactRoleConfig {
  id         Int      @id @default(autoincrement())
  nom        String   @unique
  isSendAot  Boolean  @default(false)
  ordre      Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model OdpConfig {
  annee               Int     @id @default(autoincrement())
  deliberationPath    String?
  tarifsTournagesPath String?
  tarifsOdpPath       String?
}

model BillingRun {
  id         String              @id
  type       String
  date       DateTime            @default(now())
  count      Int
  total      Float
  agent      String?
  recapPath  String?
  filienPath String?
  invoices   BillingRunInvoice[]
}

model BillingRunInvoice {
  id           Int        @id @default(autoincrement())
  billingRunId String
  dossierId    Int
  numero       String
  tiers        String
  total        Float
  pdfPath      String
  run          BillingRun @relation(fields: [billingRunId], references: [id], onDelete: Cascade)

  @@index([billingRunId])
  @@index([dossierId])
}

model Signatory {
  id                           Int                @id @default(autoincrement())
  nom                          String
  email                        String             @unique
  role                         String
  titre                        String?
  isDefault                    Boolean            @default(false)
  statut                       String             @default("ACTIF")
  signatureImagePath           String?
  signatureCertificatePath     String?
  signatureCertificatePassword String?
  created_at                   DateTime           @default(now())
  updated_at                   DateTime           @updatedAt
  signatureRequests            SignatureRequest[]
}

model SignatureRequest {
  id               Int        @id @default(autoincrement())
  occupationId     Int
  signatoriesId    Int
  status           String     @default("PENDING")
  token            String     @unique
  tokenExpiresAt   DateTime
  rejectionComment String?
  signedAt         DateTime?
  requestedByLogin String?
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt
  occupation       Occupation @relation(fields: [occupationId], references: [id], onDelete: Cascade)
  signatory        Signatory  @relation(fields: [signatoriesId], references: [id])

  @@index([occupationId])
  @@index([signatoriesId])
}

model AppSettings {
  id                     Int      @id @default(autoincrement())
  financeEmail           String?
  appUrl                 String?
  apmUrl                 String?
  apmToken               String?
  senderName             String?  @default("Domaine Public")
  senderEmail            String?  @default("dsihub@fbc.fr")
  filienOrga             String?  @default("01")
  filienBudget           String?  @default("BA")
  filienExercice         Int?
  filienAvancement       String?  @default("5")
  filienRejetDispo       Boolean? @default(true)
  filienRejetCA          Boolean? @default(false)
  filienRejetMarche      Boolean? @default(false)
  filienMouvement        String?  @default("1")
  filienType             String?  @default("R")
  filienLibelle          String?
  filienCalendrier       String?  @default("01")
  filienMonnaie          String?  @default("E")
  filienMouvementEx      String?  @default("N")
  filienPreBordereau     String?  @default("1235")
  filienPoste            String?  @default("0001")
  filienBordereau        String?  @default("0001")
  filienObjet            String?
  filienChapitre         String?  @default("")
  filienNature           String?  @default("")
  filienFonction         String?  @default("")
  filienCodeInterne      String?  @default("")
  filienTypeMouvement    String?  @default("")
  filienSens             String?  @default("")
  filienStructure        String?  @default("")
  filienGestionnaire     String?  @default("")
  filienUncPj            String?  @default("")
  adDomain               String?  @default("ivry.local")
  signataireRole         String?  @default("Le Maire d'Ivry-sur-Seine,")
  signataireDelegation   String?  @default("et par délégation,")
  signataireNom          String?  @default("Dominique Montet - Directrice Générale Adjointe")
  footer1                String?
  footer2                String?
  footer3                String?
  footerColor            String?
  updated_at             DateTime @updatedAt
  filienUncPass          String?  @default("")
  filienUncUser          String?  @default("")
  filienUncDomain        String?  @default("WORKGROUP")
  watermark              String?  @default("BROUILLON")
  dbMode                 String   @default("PROD") // PROD or DEV
  autoDistributeInvoices Boolean  @default(false)
  distributeOnlyVerified Boolean  @default(true)
}
